# === SERVER-SIDE ONLY ===
# NUNCA incluir no APK / cliente mobile.
# service_role bypassa RLS - vaza dados se disassemblado do APK.
# EXPO_ACCESS_TOKEN e usado pelo pg_net no pg_cron para despachar pushes (T5.0/T5.2).

# Obter em: Dashboard > Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# URL do projeto (mesma de EXPO_PUBLIC_SUPABASE_URL, mas para uso server-side).
# obrigatoria para a function provision-user.
SUPABASE_URL=

# Senha inicial dos jogadores criados pelo admin (UI Jogadores -> provision-user).
# O jogador pode trocar a propria senha depois do primeiro acesso.
LOCAL_AUTH_DEFAULT_PASSWORD=

# Opcional: grupo usado pelo provisionamento admin.
FIXED_GROUP_ID=00000000-0000-0000-0000-000000000001

# Obter em: expo.dev > Account Settings > Access Tokens.
# IMPORTANTE (T5.0): este arquivo NUNCA e lido pelo APK. Em producao, o token
# vive no Supabase Vault (migration 00000000000010_vault.sql) e e lido via
# `SELECT vault.decrypted_secret('expo_access_token')` pelos jobs pg_cron (T5.2).
# O valor aqui serve apenas para documentar origem + uso em dev local.
EXPO_ACCESS_TOKEN=

# Docs completas: docs/plan/20260724-futamigos-mvp/secrets-vault.md
